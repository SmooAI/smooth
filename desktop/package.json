{
    "name": "@smooai/smooth-desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Big Smooth desktop shell — Electron window + tray around the native smooth-daemon",
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsc && electron .",
        "dist": "tsc && electron-builder",
        "format": "oxfmt .",
        "lint": "oxlint .",
        "test": "tsc && node --test dist/daemon.test.js",
        "typecheck": "tsc --noEmit"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["electron", "esbuild"]
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "electron": "^40.0.0",
        "electron-builder": "^26.0.12",
        "typescript": "^5.8.3"
    }
}
