    {
      "name": "rebind, unbind, re-typed default, and every kind of problem",
      "input": {
        "fn": "parse_file",
        "platform": "other",
        "text": "# mine\n[other]\nnewTab = \"ctrl+q\"\n[keys]\nnewTab = \"ctrl+shift+y\" # comment\nclosePane = \"\"\nsplitRight = \"ctrl+shift+d\"\nbogus = \"ctrl+x\"\nkill = \"k\"\ninbox = \"ctrl+nope\"\nnot a line\n"
      },
      "expected": {
        "overrides": [
          {
            "action": "newTab",
            "wire": "ctrl+shift+y"
          },
          {
            "action": "closePane",
            "wire": null
          }
        ],
        "problems": [
          "line 8: unknown action `bogus`",
          "line 9: `k` has no modifier — a bare key would swallow terminal input",
          "line 10: `ctrl+nope` is not a shortcut (try `ctrl+shift+d`)",
          "line 11: not `action = \"chord\"` — not a line"
        ],
        "conflicts": [],
        "ctrl+shift+w": null
      }
    },
    {
      "name": "a conflict is reported, and menu order wins it",
      "input": {
        "fn": "parse_file",
        "platform": "other",
        "text": "[keys]\nnewTab = \"ctrl+shift+w\"\n"
      },
      "expected": {
        "overrides": [
          {
            "action": "newTab",
            "wire": "ctrl+shift+w"
          }
        ],
        "problems": [],
        "conflicts": [
          {
            "wire": "ctrl+shift+w",
            "actions": [
              "newTab",
              "closePane"
            ]
          }
        ],
        "ctrl+shift+w": "newTab"
      }
