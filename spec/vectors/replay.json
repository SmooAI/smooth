{
  "spec": "SmoothFlow-Client-Spec §10 replay ordering",
  "cases": [
    {
      "name": "attach, replay, then newer output",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 5,
            "cols": 80,
            "rows": 24,
            "data": "S"
          },
          {
            "type": "flow.output",
            "seq": 6,
            "data": "a"
          },
          {
            "type": "flow.output",
            "seq": 7,
            "data": "b"
          }
        ]
      },
      "expected": {
        "actions": [
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "S"
            }
          ],
          [
            {
              "op": "write",
              "data": "a"
            }
          ],
          [
            {
              "op": "write",
              "data": "b"
            }
          ]
        ],
        "baseline": 5,
        "waiting": false
      }
    },
    {
      "name": "outputs before the replay are held; the covered ones drop",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.output",
            "seq": 4,
            "data": "old"
          },
          {
            "type": "flow.output",
            "seq": 5,
            "data": "covered"
          },
          {
            "type": "flow.output",
            "seq": 6,
            "data": "new"
          },
          {
            "type": "flow.replay",
            "seq": 5,
            "cols": 80,
            "rows": 24,
            "data": "S"
          },
          {
            "type": "flow.output",
            "seq": 7,
            "data": "next"
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [],
          [],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "S"
            },
            {
              "op": "write",
              "data": "new"
            }
          ],
          [
            {
              "op": "write",
              "data": "next"
            }
          ]
        ],
        "baseline": 5,
        "waiting": false
      }
    },
    {
      "name": "output at or below the replay's seq drops",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 9,
            "cols": 80,
            "rows": 24,
            "data": "S"
          },
          {
            "type": "flow.output",
            "seq": 9,
            "data": "x"
          },
          {
            "type": "flow.output",
            "seq": 3,
            "data": "y"
          },
          {
            "type": "flow.output",
            "seq": 10,
            "data": "z"
          }
        ]
      },
      "expected": {
        "actions": [
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "S"
            }
          ],
          [],
          [],
          [
            {
              "op": "write",
              "data": "z"
            }
          ]
        ],
        "baseline": 9,
        "waiting": false
      }
    },
    {
      "name": "a later replay resets again, even with a lower seq",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 50,
            "cols": 80,
            "rows": 24,
            "data": "A"
          },
          {
            "type": "flow.output",
            "seq": 51,
            "data": "a"
          },
          {
            "type": "flow.replay",
            "seq": 2,
            "cols": 80,
            "rows": 24,
            "data": "B"
          },
          {
            "type": "flow.output",
            "seq": 3,
            "data": "b"
          }
        ]
      },
      "expected": {
        "actions": [
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "A"
            }
          ],
          [
            {
              "op": "write",
              "data": "a"
            }
          ],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "B"
            }
          ],
          [
            {
              "op": "write",
              "data": "b"
            }
          ]
        ],
        "baseline": 2,
        "waiting": false
      }
    },
    {
      "name": "lag resync mid-stream: the replay replaces the screen",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 1,
            "cols": 80,
            "rows": 24,
            "data": "A"
          },
          {
            "type": "flow.output",
            "seq": 2,
            "data": "a"
          },
          {
            "type": "flow.output",
            "seq": 3,
            "data": "b"
          },
          {
            "type": "flow.replay",
            "seq": 40,
            "cols": 80,
            "rows": 24,
            "data": "B"
          },
          {
            "type": "flow.output",
            "seq": 39,
            "data": "late"
          },
          {
            "type": "flow.output",
            "seq": 41,
            "data": "c"
          }
        ]
      },
      "expected": {
        "actions": [
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "A"
            }
          ],
          [
            {
              "op": "write",
              "data": "a"
            }
          ],
          [
            {
              "op": "write",
              "data": "b"
            }
          ],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "B"
            }
          ],
          [],
          [
            {
              "op": "write",
              "data": "c"
            }
          ]
        ],
        "baseline": 40,
        "waiting": false
      }
    },
    {
      "name": "a chunked replay renders only when complete",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "AB",
            "part": 0,
            "parts": 3
          },
          {
            "type": "flow.output",
            "seq": 8,
            "data": "x"
          },
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "CD",
            "part": 1,
            "parts": 3
          },
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "E",
            "part": 2,
            "parts": 3
          },
          {
            "type": "flow.output",
            "seq": 9,
            "data": "y"
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [],
          [],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "ABCDE"
            },
            {
              "op": "write",
              "data": "x"
            }
          ],
          [
            {
              "op": "write",
              "data": "y"
            }
          ]
        ],
        "baseline": 7,
        "waiting": false
      }
    },
    {
      "name": "a new part 0 discards an incomplete replay",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "old",
            "part": 0,
            "parts": 2
          },
          {
            "type": "flow.replay",
            "seq": 9,
            "cols": 80,
            "rows": 24,
            "data": "N",
            "part": 0,
            "parts": 2
          },
          {
            "type": "flow.replay",
            "seq": 9,
            "cols": 80,
            "rows": 24,
            "data": "EW",
            "part": 1,
            "parts": 2
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "NEW"
            }
          ]
        ],
        "baseline": 9,
        "waiting": false
      }
    },
    {
      "name": "a missing part resyncs; re-attach waits for a new replay",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "A",
            "part": 0,
            "parts": 3
          },
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "C",
            "part": 2,
            "parts": 3
          },
          {
            "type": "flow.output",
            "seq": 8,
            "data": "x"
          },
          {
            "type": "attach"
          },
          {
            "type": "flow.replay",
            "seq": 8,
            "cols": 80,
            "rows": 24,
            "data": "S"
          },
          {
            "type": "flow.output",
            "seq": 9,
            "data": "y"
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [
            {
              "op": "resync",
              "reason": "replay_gap"
            }
          ],
          [],
          [],
          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "S"
            }
          ],
          [
            {
              "op": "write",
              "data": "y"
            }
          ]
        ],
        "baseline": 8,
        "waiting": false
      }
    },
    {
      "name": "a part from another replay is a gap",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 1024,
        "frames": [
          {
            "type": "flow.replay",
            "seq": 7,
            "cols": 80,
            "rows": 24,
            "data": "A",
            "part": 0,
            "parts": 2
          },
          {
            "type": "flow.replay",
            "seq": 8,
            "cols": 80,
            "rows": 24,
            "data": "B",
            "part": 1,
            "parts": 2
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [
            {
              "op": "resync",
              "reason": "replay_gap"
            }
          ]
        ],
        "baseline": null,
        "waiting": true
      }
    },
