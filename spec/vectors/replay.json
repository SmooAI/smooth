    {
      "name": "too much held output resyncs",
      "input": {
        "expect_replay": true,
        "max_pending_bytes": 4,
        "frames": [
          {
            "type": "flow.output",
            "seq": 1,
            "data": "abc"
          },
          {
            "type": "flow.output",
            "seq": 2,
            "data": "de"
          },
          {
            "type": "attach"
          },
          {
            "type": "flow.replay",
            "seq": 2,
            "cols": 80,
            "rows": 24,
            "data": "S"
          },
          {
            "type": "flow.output",
            "seq": 3,
            "data": "f"
          }
        ]
      },
      "expected": {
        "actions": [
          [],
          [
            {
              "op": "resync",
