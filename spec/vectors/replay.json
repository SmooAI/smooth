          [
            {
              "op": "reset",
              "cols": 80,
              "rows": 24
            },
            {
              "op": "write",
              "data": "S"
            }
          ],
          [
            {
              "op": "write",
              "data": "f"
            }
          ]
        ],
        "baseline": 2,
        "waiting": false
      }
    },
    {
      "name": "re-attach forgets the baseline",
