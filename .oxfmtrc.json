{
    "printWidth": 160,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "experimentalSortImports": {
        "sortImportDeclarations": "source",
        "sortImportDeclarationSpecifiers": "source",
        "groupImportDeclarations": true
    },
    "experimentalSortPackageJson": true,
    "ignorePatterns": [
        "**/pnpm-lock.yaml",
        "CHANGELOG.md",
        "docs/.obsidian/**",
        "docs/bench-sessions/**",
        "docs/engine-baseline.json",
        "docs/model-badge.json",
        "docs/model-scores.json",
        "crates/smooth-api-client/openapi.json"
    ]
}
