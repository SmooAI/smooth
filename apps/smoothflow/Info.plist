<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-maintained. Referenced via INFOPLIST_FILE in project.yml — NOT via
     xcodegen's `info:` key, which regenerates this file and drops the usage
     strings (that silently kills every TCC prompt: EventKit returns
     granted=false with no error). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>ai.smoo.smoothflow</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SmoothFlow</string>
    <key>CFBundleDisplayName</key>
    <string>SmoothFlow</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Version: bump BOTH with scripts/bump-version.sh <x.y.z>. Sparkle compares
         CFBundleVersion, so it must move on every release; keeping it equal to the
         marketing version is the one-number rule. -->
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>0.2.0</string>
    <key>CFBundleIconFile</key>
    <string>SmoothFlow</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <!-- TCC usage strings. The app's MAIN executable asks; the daemon, tmux and
         agents it spawns inherit (see docs/Architecture/SmoothFlow-macOS.md). -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>SmoothFlow lets Smooth read and manage your calendar so agents can schedule around you.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>SmoothFlow lets Smooth read and manage your calendar so agents can schedule around you.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>SmoothFlow lets Smooth read and manage your reminders.</string>
    <key>NSRemindersUsageDescription</key>
    <string>SmoothFlow lets Smooth read and manage your reminders.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>SmoothFlow controls Messages and other apps on your behalf when an agent needs to.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>SmoothFlow notifies you when an agent needs you.</string>
    <!-- Sparkle OTA (docs/Architecture/SmoothFlow-macOS.md "Release and OTA").
         The private half of SUPublicEDKey is the SMOOTHFLOW_SPARKLE_PRIVATE_KEY
         GitHub Actions secret; smoothflow-publish.yml signs the appcast with it. -->
    <key>SUFeedURL</key>
    <string>https://downloads.smoo.ai/smoothflow/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>X1FXuUBFHg0H2X+UFsdoH2qP5JkiERmYzzVW+ZO924Q=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>3600</integer>
</dict>
</plist>
