{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/register-agent.sh"
                    }
                ]
            },
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-worktree-warning.sh"
                    }
                ]
            },
            {
                "matcher": "compact|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handoff-context.sh"
                    }
                ]
            },
            {
                "matcher": "clear|startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "th harness handoff claim --harness claude-code 2>/dev/null || exit 0"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code SessionStart || exit 0"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/on-first-prompt.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code UserPromptSubmit || exit 0"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mail-guard.sh prompt"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th harness budget --harness claude-code 2>/dev/null || exit 0"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/enforce-worktree.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/enforce-worktree.sh"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/th-curl-hint.sh"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pearls-store-guard.sh"
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/attest-push-hint.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code PreToolUse || exit 0"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/enforce-pearls-labels.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code PostToolUse || exit 0"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th harness budget --harness claude-code 2>/dev/null || exit 0"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code PermissionRequest || exit 0",
                        "timeout": 125
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code Notification || exit 0"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code Stop || exit 0"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mail-guard.sh stop"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th harness budget --harness claude-code 2>/dev/null || exit 0"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code SubagentStop || exit 0"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code PreCompact || exit 0"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "th flow hook claude-code SessionEnd || exit 0"
                    }
                ]
            }
        ]
    }
}
