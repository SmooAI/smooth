{
    "version": 1,
    "hooks": {
        "SessionStart": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh SessionStart copilot",
                "timeoutSec": 5
            }
        ],
        "UserPromptSubmit": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh UserPromptSubmit copilot",
                "timeoutSec": 5
            }
        ],
        "PreToolUse": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh PreToolUse copilot",
                "timeoutSec": 5
            }
        ],
        "PostToolUse": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh PostToolUse copilot",
                "timeoutSec": 5
            }
        ],
        "PostToolUseFailure": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh PostToolUseFailure copilot",
                "timeoutSec": 5
            }
        ],
        "Stop": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh Stop copilot",
                "timeoutSec": 5
            }
        ],
        "ErrorOccurred": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh ErrorOccurred copilot",
                "timeoutSec": 5
            }
        ],
        "Notification": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh Notification copilot",
                "timeoutSec": 5
            }
        ],
        "SessionEnd": [
            {
                "type": "command",
                "bash": "${CLAUDE_PLUGIN_ROOT}/hooks/flow-hook.sh SessionEnd copilot",
                "timeoutSec": 5
            }
        ]
    }
}
