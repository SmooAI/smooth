{
    "manifest_version": 3,
    "name": "Smooth",
    "description": "Lets th and your coding agents manage your Chrome bookmarks (synced included) and, if you turn it on, drive tabs.",
    "version": "0.1.0",
    "minimum_chrome_version": "134",
    "key": "",
    "permissions": ["bookmarks", "nativeMessaging", "alarms"],
    "optional_permissions": ["tabs", "scripting", "tabGroups", "debugger"],
    "optional_host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js" },
    "action": { "default_title": "Smooth", "default_popup": "popup.html" }
}
