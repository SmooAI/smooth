    "WorkflowStepTypeListResponseSchema": [
        {
            "items": [
                {
                    "type": "send_email",
                    "label": "Send email",
                    "description": "Send an email through the org's SendGrid integration. `to`, `subject` and the Markdown `body` accept {{templates}}.",
                    "requiredPermission": "communications.email.send"
                },
                {
                    "type": "wait",
                    "label": "Wait",
                    "description": "Pause the run for an ISO-8601 duration (PT15M, P3D). The only step a loop may pass through.",
                    "requiredPermission": null
                },
                {
                    "type": "branch",
                    "label": "Branch",
                    "description": "Choose the next step by JsonLogic conditions; the first matching branch wins, otherwise `defaultNext`.",
                    "requiredPermission": null
                },
                {
                    "type": "crm_update",
                    "label": "Update CRM record",
                    "description": "Set fields on a contact or deal (the triggering one by default). Needs crm.contacts.write for a contact, crm.deals.write for a deal.",
                    "requiredPermission": null
                },
                {
                    "type": "add_tag",
                    "label": "Add tag",
                    "description": "Tag a contact (the triggering contact by default).",
                    "requiredPermission": "crm.contacts.write"
                },
                {
                    "type": "create_task",
                    "label": "Create task",
                    "description": "Create a CRM task, optionally assigned and linked to a contact or deal, due N days out.",
                    "requiredPermission": "crm.tasks.write"
                },
                {
                    "type": "notify",
                    "label": "Notify",
                    "description": "Send an in-app notification to the org admins or to named users.",
                    "requiredPermission": null
                },
                {
                    "type": "webhook_out",
                    "label": "Call webhook",
                    "description": "POST/PUT/PATCH a JSON body to an https URL. The body defaults to the triggering event.",
                    "requiredPermission": null
                }
            ]
        }
    ]
}
